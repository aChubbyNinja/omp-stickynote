# Run native/bin/package so makepkg's src/ and pkg/ never overlap project sources.
pkgname=omp-stickynote-overlay
pkgver=1.5.0
pkgrel=1
pkgdesc='Transparent click-through Hyprland companion for OMP sticky notes'
arch=('x86_64' 'aarch64')
url='https://github.com/aChubbyNinja/omp-stickynote'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'layer-shell-qt' 'wayland')
makedepends=('gcc' 'make' 'pkgconf')
options=('!debug')
source=()
sha256sums=()

build() {
    cd "$startdir/../.."
    ./native/bin/build
}

package() {
    cd "$startdir/../.."
    install -Dm755 native/build/omp-stickynote-overlay "$pkgdir/usr/bin/omp-stickynote-overlay"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
