#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
for suite in desktopstate_tests overlay_tests; do
    mkdir -p "$ROOT/build/tests/$suite.build"
    cd "$ROOT/build/tests/$suite.build"
    qmake6 "$ROOT/tests/$suite.pro"
    make -j"${JOBS:-$(nproc)}"
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software "./$suite" "$@"
done
